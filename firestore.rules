
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'ngogrant454@gmail.com',
          'zaradigitalseva@gmail.com'
        ];
    }

    // Public NGO profiles: only approved statuses
    match /ngos/{ngoId} {
      allow read: if isSuperAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || resource.data.status in ['LIVE', 'ACTIVE', 'APPROVED'];
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberFee', 'adminWhatsApp', 'updatedAt'])
          && request.resource.data.memberFee is number
          && request.resource.data.memberFee >= 1
          && request.resource.data.memberFee <= 100000
          && request.resource.data.adminWhatsApp is string
          && request.resource.data.adminWhatsApp.size() >= 10
          && request.resource.data.adminWhatsApp.size() <= 20);
    }

    // Subscription plans: active plans are visible to registration forms; only Super Admin can manage them.
    match /subscriptionPlans/{planId} {
      allow read: if isSuperAdmin() || resource.data.active == true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Private NGO registration and payment review
    match /ngoRegistrations/{registrationId} {
      // Owners may read only their own registration status; only Super Admin may review or delete.
      allow read: if isSuperAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'name', 'contactName', 'email', 'phone', 'state', 'district', 'mission', 'imageData',
          'planId', 'subscriptionPlan', 'planPrice', 'planDurationDays',
          'paymentReference', 'status', 'paymentStatus', 'ownerUid', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'contactName', 'email', 'phone', 'state', 'district', 'mission', 'imageData',
          'planId', 'subscriptionPlan', 'planPrice', 'planDurationDays',
          'paymentReference', 'status', 'paymentStatus', 'ownerUid', 'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'PENDING_PAYMENT'
        && request.resource.data.paymentStatus
          in ['NOT_SUBMITTED', 'SUBMITTED_FOR_REVIEW']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() > 1
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 25
        && request.resource.data.mission is string
        && request.resource.data.mission.size() <= 1000
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 180000
        && request.resource.data.planId is string
        && request.resource.data.planId.size() > 0
        && exists(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId))
        && get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.active == true
        // Accept legacy plan field names that the registration UI already supports.
        && request.resource.data.subscriptionPlan == get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('name', get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('planName', ''))
        && request.resource.data.planPrice == get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('price', get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('fee', get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('amount', 0)))
        && request.resource.data.planDurationDays == get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('durationDays', get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('validityDays', get(/databases/$(database)/documents/subscriptionPlans/$(request.resource.data.planId)).data.get('duration', 0)))
        && request.resource.data.planPrice is number && request.resource.data.planPrice > 0
        && request.resource.data.planDurationDays is int && request.resource.data.planDurationDays >= 1
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() <= 80
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isSuperAdmin();
    }

    // Dashboard carousel images: only Super Admins can manage and read these records.
    match /dashboardSlides/{slideId} {
      // Homepage slideshow images are public; only Super Admin can manage them.
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Public payment QR: visitors can read, only admins can change it
    match /publicSettings/{settingId} {
      allow read: if settingId == 'payment' || isSuperAdmin();
      allow write: if isSuperAdmin();
    }


    // Legacy Aadhaar-based membership request endpoint is retired; new applications use memberApplications.
    match /memberApplications/{applicationId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ngoId', 'ngoName', 'applicantUid', 'applicantEmail', 'name',
          'fatherName', 'phone', 'address', 'photoData', 'feeAmount',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ngoId', 'ngoName', 'applicantUid', 'applicantEmail', 'name',
          'fatherName', 'phone', 'address', 'photoData', 'feeAmount',
          'status', 'createdAt'
        ])
        && request.resource.data.applicantEmail is string
        && request.resource.data.applicantEmail.size() <= 160
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.ngoId is string
        && request.resource.data.ngoName == get(/databases/$(database)/documents/ngos/$(request.resource.data.ngoId)).data.get('name', get(/databases/$(database)/documents/ngos/$(request.resource.data.ngoId)).data.get('ngoName', ''))
        && get(/databases/$(database)/documents/ngos/$(request.resource.data.ngoId)).data.status in ['LIVE', 'ACTIVE', 'APPROVED']
        && get(/databases/$(database)/documents/ngos/$(request.resource.data.ngoId)).data.memberFee == request.resource.data.feeAmount
        && get(/databases/$(database)/documents/ngos/$(request.resource.data.ngoId)).data.adminWhatsApp is string
        && get(/databases/$(database)/documents/ngos/$(request.resource.data.ngoId)).data.adminWhatsApp.size() >= 10
        && request.resource.data.status == 'PENDING_PAYMENT'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.fatherName is string
        && request.resource.data.fatherName.size() > 1
        && request.resource.data.fatherName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 500000
        && request.resource.data.feeAmount is number
        && request.resource.data.feeAmount >= 1
        && request.resource.data.createdAt == request.time;
      allow read: if isSuperAdmin()
        || (request.auth != null && resource.data.applicantUid == request.auth.uid)
        || (request.auth != null
          && get(/databases/$(database)/documents/ngos/$(resource.data.ngoId)).data.ownerUid == request.auth.uid);
      allow update: if isSuperAdmin()
        || (request.auth != null
          && resource.data.status == 'PENDING_PAYMENT'
          && get(/databases/$(database)/documents/ngos/$(resource.data.ngoId)).data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'memberId', 'rejectionReason', 'reviewedAt', 'reviewedBy'])
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && request.resource.data.reviewedBy == request.auth.uid
          && (request.resource.data.status != 'APPROVED'
            || (request.resource.data.memberId is string
              && request.resource.data.memberId.size() >= 5)));
      // The owning NGO admin can remove its own application; super admins can remove any.
      allow delete: if isSuperAdmin()
        || (request.auth != null
          && get(/databases/$(database)/documents/ngos/$(resource.data.ngoId)).data.ownerUid == request.auth.uid);
    }

    // Minimal public verification record: never expose phone, address, or photo here.
    match /memberVerifications/{memberId} {
      // QR verification uses a direct document lookup; public collection listing is blocked.
      allow get: if true;
      allow list: if false;
      // NGO owners may create a new minimal verification record only as part of the
      // same atomic batch that approves its application. They cannot overwrite IDs.
      allow create: if isSuperAdmin()
        || (request.auth != null
          && !exists(/databases/$(database)/documents/memberVerifications/$(memberId))
          && request.resource.data.keys().hasOnly([
            'memberId', 'name', 'ngoId', 'ngoName', 'applicationId', 'status', 'approvedAt'
          ])
          && request.resource.data.keys().hasAll([
            'memberId', 'name', 'ngoId', 'ngoName', 'applicationId', 'status', 'approvedAt'
          ])
          && request.resource.data.applicationId is string
          && request.resource.data.ngoId is string
          && request.resource.data.memberId == memberId
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.approvedAt == request.time
          && get(/databases/$(database)/documents/ngos/$(request.resource.data.ngoId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/memberApplications/$(request.resource.data.applicationId)).data.ngoId == request.resource.data.ngoId
          && getAfter(/databases/$(database)/documents/memberApplications/$(request.resource.data.applicationId)).data.status == 'APPROVED'
          && getAfter(/databases/$(database)/documents/memberApplications/$(request.resource.data.applicationId)).data.memberId == memberId
          && request.resource.data.name == getAfter(/databases/$(database)/documents/memberApplications/$(request.resource.data.applicationId)).data.name
          && request.resource.data.ngoName == getAfter(/databases/$(database)/documents/memberApplications/$(request.resource.data.applicationId)).data.ngoName);
      allow update, delete: if isSuperAdmin();
    }

    // NGO-owned management data. Each document is bound to an NGO and its owner UID.
    function ownsNgo(ngoId) {
      return request.auth != null
        && get(/databases/$(database)/documents/ngos/$(ngoId)).data.ownerUid == request.auth.uid;
    }

    match /ngoMembers/{recordId} {
      allow read: if isSuperAdmin() || ownsNgo(resource.data.ngoId) || resource.data.approvalStatus == 'APPROVED';
      allow create: if isSuperAdmin() || (ownsNgo(request.resource.data.ngoId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ngoId is string
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.role in ['MEMBER','VOLUNTEER']
        && request.resource.data.status in ['ACTIVE','INACTIVE']
        && request.resource.data.approvalStatus in ['PENDING', 'APPROVED']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      allow update: if isSuperAdmin() || (ownsNgo(resource.data.ngoId)
        && request.resource.data.ngoId == resource.data.ngoId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','email','role','status','designation','location','approvalStatus','updatedAt'])
        && request.resource.data.approvalStatus in ['PENDING', 'APPROVED']
        && request.resource.data.updatedAt == request.time);
      allow delete: if isSuperAdmin() || ownsNgo(resource.data.ngoId);
    }

    match /ngoTransactions/{recordId} {
      allow read: if isSuperAdmin() || ownsNgo(resource.data.ngoId) || resource.data.approvalStatus == 'APPROVED';
      allow create: if isSuperAdmin() || (ownsNgo(request.resource.data.ngoId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ngoId is string
        && request.resource.data.type in ['DONATION','EXPENSE']
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.category is string
        && request.resource.data.date is string
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      allow update: if isSuperAdmin() || (ownsNgo(resource.data.ngoId)
        && request.resource.data.ngoId == resource.data.ngoId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','amount','category','donor','date','note','approvalStatus','updatedAt'])
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.updatedAt == request.time);
      allow delete: if isSuperAdmin() || ownsNgo(resource.data.ngoId);
    }

    match /ngoEvents/{recordId} {
      allow read: if isSuperAdmin() || ownsNgo(resource.data.ngoId) || resource.data.approvalStatus == 'APPROVED';
      allow create: if isSuperAdmin() || (ownsNgo(request.resource.data.ngoId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ngoId is string
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.date is string
        && request.resource.data.status in ['PLANNED','COMPLETED','CANCELLED']
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      allow update: if isSuperAdmin() || (ownsNgo(resource.data.ngoId)
        && request.resource.data.ngoId == resource.data.ngoId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','date','location','description','status','approvalStatus','updatedAt'])
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.updatedAt == request.time);
      allow delete: if isSuperAdmin() || ownsNgo(resource.data.ngoId);
    }

    match /ngoDocuments/{recordId} {
      allow read: if isSuperAdmin() || ownsNgo(resource.data.ngoId) || resource.data.approvalStatus == 'APPROVED';
      allow create: if isSuperAdmin() || (ownsNgo(request.resource.data.ngoId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ngoId is string
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.type in ['REPORT','CERTIFICATE','OTHER']
        && request.resource.data.url is string
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      allow update: if isSuperAdmin() || (ownsNgo(resource.data.ngoId)
        && request.resource.data.ngoId == resource.data.ngoId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','type','url','notes','approvalStatus','updatedAt'])
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.updatedAt == request.time);
      allow delete: if isSuperAdmin() || ownsNgo(resource.data.ngoId);
    }

    match /publicTickerMessages/{messageId} {
      allow read: if true;
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['text', 'color', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['text', 'color', 'createdAt', 'createdBy'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.color in ['rainbow', 'blue', 'green', 'orange', 'purple']
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Protect all other collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
