rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ngogrant454@gmail.com', 'zaradigitalseva@gmail.com'];
    }
    // Only the two explicitly approved Super Admin Google accounts may access
    // platform data. NGO-member permissions must be added before NGO Admin launch.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
