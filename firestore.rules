rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ngogrant454@gmail.com', 'zaradigitalseva@gmail.com'];
    }

    // Public users can read only approved/live NGO profile documents.
    // All writes remain restricted to the Super Admin until NGO role rules are implemented.
    match /ngos/{ngoId} {
      allow read: if isSuperAdmin()
        || resource.data.status in ['LIVE', 'ACTIVE', 'APPROVED'];
      allow write: if isSuperAdmin();
    }

    // Other collections may contain private financial, member, document, or account data.
    // Keep them restricted to the explicitly authorized Super Admin accounts.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
