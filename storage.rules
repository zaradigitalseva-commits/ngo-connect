rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'ngogrant454@gmail.com',
          'zaradigitalseva@gmail.com'
        ];
    }

    match /homepage-video/{fileName} {
      // The active homepage video is public so visitors can play it.
      allow read: if true;

      // Only verified Super Admins can upload an MP4 up to 100 MB or delete files.
      allow create, update: if isSuperAdmin()
        && request.resource != null
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
      allow delete: if isSuperAdmin();
    }
  }
}
